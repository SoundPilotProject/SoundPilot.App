rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // every user can only read/write his own /users/{uid}
    // NOTE: Before, one rule `allow read, write` covered the document and all
    // subcollections, so the client could also create and delete its own
    // document and overwrite any field. Now the document is created and
    // deleted only by the cloud functions `createUserDoc` / `deleteUserDoc`
    // (they use the Admin SDK, which ignores these rules), and the client may
    // only update `calibration` and `settings`. `uid`, `email`, `displayName`,
    // `createdAt`, `providers` and `schemaVersion` are read-only for clients.
    // NOTE: There are no subcollections yet. They stay blocked by the default
    // rule below until a rule for them is added on purpose.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid; // only logged in users
      allow create, delete: if false;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['calibration', 'settings']);
    }

    // lock everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
